# Copy this file to .env.local and fill in the values.
# Never commit your real .env.local — it is gitignored.

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string (Neon or Vercel Postgres recommended for Vercel)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Auth & encryption ────────────────────────────────────────────────────────
# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET="your-session-secret-here"

# Key used to encrypt secrets at rest (e.g. Plaid tokens).
# Generate with: openssl rand -base64 32. Falls back to SESSION_SECRET if unset.
# Do not change this once data is encrypted, or existing tokens become unreadable.
ENCRYPTION_KEY=""

# ── App ──────────────────────────────────────────────────────────────────────
# Base URL used in emails and links (no trailing slash)
APP_URL="http://localhost:3000"

# ── Plaid (bank connections) ─────────────────────────────────────────────────
# From https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID="your-plaid-client-id"
PLAID_SECRET="your-plaid-secret"
PLAID_ENV="sandbox" # "sandbox" or "production"

# Required for OAuth banks (BofA, USAA, Chase, etc.) in production.
# Must exactly match a redirect URI registered in the Plaid dashboard.
# e.g. https://your-app.vercel.app/accounts — leave blank for sandbox.
PLAID_REDIRECT_URI=""

# ── Email (optional — logs to console in dev if unset) ───────────────────────
# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Ashtronomical <noreply@yourdomain.com>"

# ── Cron jobs (optional) ─────────────────────────────────────────────────────
# Shared secret to protect /api/cron/* routes. Set the same value in Vercel.
CRON_SECRET=""
